APP_NAME=Tradeon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development defaults (SQLite + database queue/cache).
# For MySQL/Redis switch the *_CONNECTION values and fill the hosts below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tradeon
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# First-admin bootstrap (optional). When all three are set, `php artisan db:seed`
# creates or updates the administrator account. Leave empty otherwise.
# Prefer `php artisan tradeon:admin` for interactive creation.
TRADEON_ADMIN_NAME=
TRADEON_ADMIN_USERNAME=
TRADEON_ADMIN_EMAIL=
TRADEON_ADMIN_PASSWORD=

# HTTPS enforcement (enable in production behind TLS).
APP_FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false

# Tradeon Billing (Paddle). Leave empty until Paddle is configured;
# the pricing page automatically shows "setup mode" meanwhile.
BILLING_PROVIDER=paddle
BILLING_CURRENCY=USD
# Free publishing storage (MB) granted to every company owner at registration.
FREE_STORAGE_MB=30
PADDLE_ENV=sandbox
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=

# Realtime (Laravel Reverb). Defaults run a local ws server for development.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Optional production services (see .env.production.example).
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=*
