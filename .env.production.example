APP_NAME=Tradeon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FORCE_HTTPS=true

# Sessions must be secure in production.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# MySQL (production database).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradeon
DB_USERNAME=tradeon
DB_PASSWORD=

# Redis (sessions, cache, queue).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP mail delivery.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Tradeon

# Realtime (Laravel Reverb) behind TLS / reverse proxy.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https
# Comma-separated list of production origins allowed to open sockets, e.g.
# REVERB_ALLOWED_ORIGINS=https://example.com,https://www.example.com
REVERB_ALLOWED_ORIGINS=https://example.com
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}

# Billing (Paddle production). All values are required for live checkout.
BILLING_PROVIDER=paddle
BILLING_CURRENCY=USD
# Free publishing storage (MB) granted to every company owner at registration.
FREE_STORAGE_MB=30
PADDLE_ENV=live
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=

# Admin bootstrap (used by `php artisan db:seed`; prefer `php artisan tradeon:admin`).
TRADEON_ADMIN_NAME=
TRADEON_ADMIN_USERNAME=
TRADEON_ADMIN_EMAIL=
TRADEON_ADMIN_PASSWORD=

# Restrict browser cross-origin access in production.
CORS_ALLOWED_ORIGINS=https://example.com

# Logging & monitoring (leave SENTRY_DSN empty to disable).
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups (used by `php artisan tradeon:backup`; cron runs it daily at 02:30).
BACKUP_KEEP_DAYS=7
